# Required for LangGraph Company Brain streaming chat
OPENAI_API_KEY=

# Optional model override (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Advisor portal gate (default in dev: berlinxkw)
PORTAL_PASSCODE=berlinxkw

# Vercel Blob — AppState JSON + LangGraph checkpoint JSON on serverless (recommended for production)
# Create a Blob store in the Vercel project; this variable is set automatically.
BLOB_READ_WRITE_TOKEN=

# Durable LangGraph threads (preferred when available — e.g. Neon)
# DATABASE_URL=postgresql://...

# LangSmith tracing (optional — chat works without)
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=berlinxkw

# Instagram metrics — optional free Meta Graph API sync (Professional @berlinxkw account)
# See docs/INSTAGRAM_METRICS.md. Manual entry on /portal/system works without these.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Langfuse tracing (optional second observer)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=  # legacy alias; mapped to LANGFUSE_BASE_URL at runtime
