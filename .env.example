# Required for LangGraph Company Brain streaming chat
OPENAI_API_KEY=

# Optional model override (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Advisor portal gate (default in dev: berlinxkw)
PORTAL_PASSCODE=berlinxkw

# Vercel Blob — AppState JSON + LangGraph checkpoint JSON on serverless (recommended for production)
# Create a Blob store in the Vercel project; this variable is set automatically.
BLOB_READ_WRITE_TOKEN=

# Durable LangGraph threads (preferred when available — e.g. Neon)
# DATABASE_URL=postgresql://...

# LangSmith tracing (optional — chat works without)
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=berlinxkw

# Langfuse tracing (optional second observer)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
